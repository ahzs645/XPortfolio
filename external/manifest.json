{
  "projects": [
    {
      "name": "spider-solitaire",
      "path": "external/spider-solitaire",
      "packageManager": "npm",
      "buildCommand": "npm run build",
      "buildOutput": "build",
      "deployTarget": "public/games/spider-solitaire",
      "requiredDeployFiles": ["index.html"],
      "type": "game",
      "envOverrides": { "CI": "false" }
    },
    {
      "name": "js-solitaire",
      "path": "external/js-solitaire",
      "packageManager": "pnpm",
      "ignoreWorkspace": true,
      "buildCommand": "pnpm --ignore-workspace run build",
      "buildOutput": "dist",
      "deployTarget": "public/games/solitaire",
      "requiredDeployFiles": ["index.html"],
      "type": "game"
    },
    {
      "name": "emupedia-game-command-and-conquer1",
      "path": "external/emupedia-game-command-and-conquer1",
      "packageManager": "none",
      "buildCommand": null,
      "buildOutput": null,
      "deployTarget": "public/games/command-and-conquer",
      "requiredDeployFiles": ["index.html", "js", "css"],
      "type": "game",
      "copyFiles": [
        "index.html",
        "js",
        "css",
        "images",
        "audio",
        "maps",
        "templates",
        "videos",
        "favicon.ico"
      ]
    },
    {
      "name": "isle-portable",
      "path": "external/isle-portable",
      "packageManager": "none",
      "buildCommand": null,
      "buildOutput": null,
      "deployTarget": "public/games/legoIsland",
      "requiredDeployFiles": ["index.html", "isle.js", "isle.wasm"],
      "type": "game",
      "note": "Pre-built WASM artifacts (index.html, isle.js, isle.wasm) are committed directly to public/games/legoIsland/ since building from source requires Emscripten/CMake"
    },
    {
      "name": "jspaint",
      "path": "external/jspaint",
      "packageManager": "none",
      "buildCommand": null,
      "buildOutput": null,
      "deployTarget": "public/apps/jspaint",
      "requiredDeployFiles": ["index.html", "about.html", "privacy.html"],
      "type": "app",
      "copyFiles": [
        "index.html",
        "about.html",
        "privacy.html",
        "src",
        "lib",
        "images",
        "styles",
        "localization",
        "help",
        "audio",
        "favicon.ico",
        "manifest.webmanifest"
      ]
    },
    {
      "name": "steam-app",
      "path": "external/steam-app",
      "packageManager": "none",
      "buildCommand": null,
      "buildOutput": null,
      "deployTarget": "public/apps/steam",
      "requiredDeployFiles": ["index.html", "public/pages/library.html"],
      "type": "app",
      "copyFiles": [
        "index.html",
        "public"
      ]
    },
    {
      "name": "playsrc",
      "path": "external/playsrc",
      "packageManager": "none",
      "buildCommand": "node ../../scripts/sync-playsrc-runtime.mjs",
      "buildOutput": null,
      "deployTarget": "public/tf2",
      "requiredDeployFiles": ["index.html", "playsrc-config.json", "assets"],
      "type": "game",
      "note": "Pins the playsrc source while syncing its matching published frontend. Local Vite proxies origin-restricted game objects; production requires an equivalent deployed asset proxy."
    }
  ]
}
